[Unit]
Description=ApexDaemon — plugin-style background automation
Documentation=https://github.com/cybercore-tech/apexdaemon
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.cargo-target/release/apexdaemon --config %h/.config/apexdaemon/config.toml
Restart=on-failure
RestartSec=5
TimeoutStopSec=10

# No systemd sandboxing directives on this unit -- verified live, not
# guessed. This machine routes every `ssh` invocation through a
# setuid-root firejail wrapper (/usr/local/bin/ssh -> firejail), which
# repo-housekeeping's `git fetch` and vault-backup's `git push` both
# depend on, and firejail cannot run inside ANY of the directives that
# would otherwise be safe defaults for a --user unit:
#
#   - LockPersonality=yes and RestrictRealtime=yes are both
#     implemented via an unprivileged seccomp filter, which the kernel
#     will only install if the process's NoNewPrivs bit is already
#     set -- confirmed directly (`systemd-run --user
#     --property=LockPersonality=yes -- grep NoNewPrivs
#     /proc/self/status` reports `1`, even though `systemctl show -p
#     NoNewPrivileges` on that same unit reports `no`). That kernel-
#     level bit, not the systemd property, is what blocks firejail's
#     setuid bit from taking effect, and firejail then fails outright
#     ("cannot create a lockfile at /run/firejail/firejail-run.lock:
#     Permission denied").
#   - ProtectKernelTunables=yes, ProtectKernelModules=yes, and
#     ProtectControlGroups=yes each build a private mount namespace
#     for the unit; inside it firejail's own root-ownership checks
#     fail a different way ("create_empty_dir_as_root: Assertion
#     `s.st_uid == 0' failed") -- confirmed the same way, one
#     directive at a time.
#   - NoNewPrivileges=yes itself is the most direct case: it blocks
#     the setuid bit from taking effect on exec at all.
#
# Every one of these was tested individually against this host's real
# `ssh` before being ruled out -- this isn't a blanket "sandboxing is
# scary" decision, it's specific to running as an unprivileged --user
# unit on a machine that wraps ssh in a setuid sandbox. Whether a
# --system unit (with real CAP_SYS_ADMIN available) would avoid this
# is untested and not assumed either way. Breaking every git operation
# this daemon exists to do is a worse outcome than the hardening these
# directives would have bought on a single-user desktop.

[Install]
WantedBy=default.target
